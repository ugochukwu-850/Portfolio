{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": "sveltekit",
	"installCommand": "npm ci",
	"buildCommand": "npm run build",
	"redirects": [
		{
			"source": "/:path(.*)",
			"has": [{ "type": "host", "value": "www.chizaram-ugochukwu.cv" }],
			"destination": "https://chizaram-ugochukwu.cv/:path",
			"permanent": true
		}
	]
}
